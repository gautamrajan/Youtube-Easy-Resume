{
  "name": "youtube-easy-resume",
  "version": "0.0.1.7",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "dev:firefox": "web-ext run --source-dir dist/firefox",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "preact": "10.29.8",
    "preact-material-components": "1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "vitest": "4.1.10",
    "web-ext": "10.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
